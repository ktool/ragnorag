{
  "name": "rag-evaluation-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run typecheck --workspace shared && npm run build --workspace server && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces",
    "ingest": "npm run ingest --workspace server",
    "corpus:download": "npm run corpus:download --workspace server"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
